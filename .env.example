# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Google Apps Script Web App API Configuration (Single Source of Truth)
# Replace with the Web App URL generated when deploying your Apps Script (ends with /exec)
VITE_GOOGLE_APPS_SCRIPT_URL="https://script.google.com/macros/s/AKfycbwXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX/exec"

# Admin Token for authorized operations (matches ADMIN_TOKEN in Apps Script Properties)
VITE_ADMIN_TOKEN="admin-token-bem-2026"
